.input|xwiki/2.0
.# Query source test - the default source: the macro content is a textual query, whose names are passed as text when
.# the client doesn't resolve them.
.#-----------------------------------------------------
{{test displayer="list"}}
type = "bug" AND identifier IN (WorkItem1, WorkItem2)
{{/test}}
