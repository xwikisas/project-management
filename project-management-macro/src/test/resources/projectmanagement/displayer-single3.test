.runTransformations
.#-----------------------------------------------------
.input|xwiki/2.0
.# Single displayer test - display a work item with incomplete values: its identifier has no location, so it isn't
.# linked.
.#-----------------------------------------------------
{{test workItemsDisplayer="workItemsSingle" filters="{~"query~":{~"filters~":[{~"property~":~"identifier~",~"constraints~":[{~"operator~":~"equals~",~"value~":~"WorkItem2~"}]}]}}"/}}
.#-----------------------------------------------------
.expect|xhtml/1.0
.#-----------------------------------------------------
<div class="work-item-page-displayer"><div class="work-item-header"><div class="work-item-header-name"><p>Do this thing!</p></div><div class="work-item-header-id"><p>Test work item #WorkItem2</p></div></div><div class="row"><div class="col-md-12"><p>Work Item from project:&nbsp;</p></div></div><div class="row"><div class="col-md-4 col-xs-12"><table></table></div><div class="col-md-4 col-xs-12"><table><tr><td class="work-item-property-name">Reporter:</td><td class="work-item-property-value"></td></tr></table></div><div class="col-md-4 col-xs-12"><table></table></div></div><div class="work-package-description"><div class="work-item-property-name">Description</div><p>This is some nice description</p></div></div>
