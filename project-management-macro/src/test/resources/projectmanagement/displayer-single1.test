.runTransformations
.#-----------------------------------------------------
.input|xwiki/2.0
.# Single displayer test - display a filter that returns no work items, with the message translated for the client.
.#-----------------------------------------------------
{{test workItemsDisplayer="workItemsSingle" filters="{~"query~":{~"filters~":[{~"property~":~"identifier~",~"constraints~":[{~"operator~":~"equals~",~"value~":~"NonExistentWorkItem~"}]}]}}"/}}
.#-----------------------------------------------------
.expect|xhtml/1.0
.#-----------------------------------------------------
<div class="box warningmessage"><p>No test work item matches this filter.</p></div>
