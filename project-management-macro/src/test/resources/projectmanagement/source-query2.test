.# Query source test - the conditions repeated on a property are combined into one filter, whatever the case of the
.# keywords and the spaces (a tabulation, non-breaking spaces) between the words.
.#-----------------------------------------------------
{{test displayer="list"}}
type in ("bug", "story")	and type NOT IN ("story") AND type = "bug"
{{/test}}
