## The value of the deprecated filters parameter (Live Data filters as JSON), which the macro editor doesn't display:
## the filter builder of the widget of the source parameter imports it (see workItemSourceParameter.js), and the widget
## clears it once the filters are written as a query in the macro content.
<textarea class="proj-manag-filter hidden" data-legacy-filters="true"
  #foreach ($parameter in $displayer.parameters.entrySet())
    $escapetool.xml($parameter.key)="$!escapetool.xml($parameter.value)"
  #end
>$!escapetool.xml($displayer.value)</textarea>