#template("pickers_macros.vm")
#template("macro_parameter_label.vm")
#macro (displayPresetPicker $client $chart)
  #if ("$!chart" == '')
    #set ($chart = false)
  #end
  #set ($options = [])
  #foreach ($preset in $services.projectmanagement.presets.getPresetsForClient($client, $chart, 0, 25))
    #set ($discard = $options.add({ 'name': "$!preset.name", 'value': "$!preset.id"}))
  #end
  #set ($parameters = {
    'options': $options,
    'prefix': ' ',
    'class': 'op-preset-select'
  })
  #set ($discard = $parameters.putAll($displayer.parameters))
  #pmLabelPickerAsParameter($parameters)
  #if ($options.isEmpty() && "$!displayer.value" == '')
    ## An empty picker would open no list: say why there's nothing to choose. The macros only list the presets of
    ## their kind (chart or not), so say which kind is missing: the other kind may exist.
    #set ($noneKey = 'projectmanagement.macro.filter.preset.none')
    #if ($chart)
      #set ($noneKey = "${noneKey}.chart")
    #end
    ## The disabled select has the name and the id of the field of the parameter, which the macro editor labels (see
    ## macro_parameter_label.vm). The macro editor renders this field once for all the macros, without their values,
    ## then puts the preset of the edited macro in it, adding its option: a macro can use a preset that isn't listed
    ## here (deleted, not viewable by the current user). The widget of the source parameter then enables the field
    ## (see workItemSourceParameter.js), so that Submit keeps the preset, a disabled field holding no value.
    #set ($nameAttributes = '')
    #if ("$!displayer.parameters.name" != '')
      #set ($name = $escapetool.xml($displayer.parameters.name))
      #set ($nameAttributes = "id=""parameter-$name"" name=""$name""")
    #end
    <select $nameAttributes class="form-control op-preset-select" disabled="disabled">
      <option value="">$escapetool.xml($services.localization.render($noneKey))</option>
    </select>
  #else
    #staticSelectPicker($parameters)
  #end
#end
#if ("$!client" != '')
  #displayPresetPicker($client, $chart)
#end
