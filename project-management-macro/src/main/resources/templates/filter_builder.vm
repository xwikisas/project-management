#**
 * Retrieves the properties of a client that work items can be filtered on.
 *
 * @param $clientId the client, e.g. openproject
 * @param $sourceParameters the parameters of the livedata source the properties can depend on, e.g. the instance of
 *   the client whose own properties (such as custom fields) are added to the generic ones
 * @param $return the variable receiving the livedata property descriptors, or null if the client configuration
 *   couldn't be resolved
 *#
#macro (getFilterableProperties $clientId $sourceParameters $return)
  #set ($filterablePropertiesResult = $NULL)
  #set ($clientCfg = $services.projectmanagement.livedata.getLivedataConfiguration($clientId, $sourceParameters))
  #if ("$!clientCfg" != '')
    #set ($filterablePropertiesResult = [])
    #foreach ($prop in $clientCfg.meta.propertyDescriptors)
      #if ($prop.filter && $prop.filter.id)
        #set ($discard = $filterablePropertiesResult.add($prop))
      #end
    #end
  #end
  #setVariable("$return" $filterablePropertiesResult)
#end

#**
 * Generate the html structure for a filter builder.
 *
 * @param $parameters a map of parameters that can be used by the builder. The 'client' property will be used to
 *   retrieve the filterable livedata properties. The 'title' property will be used to set the title of the builder. The
 *   'removable' property will denote whether the builder can be removed or not. The 'readonly' property will make the
 *   filter builder un-editable.
 *#
#macro (filterBuilder $parameters)
#picker_import
#set ($discard = $xwiki.linkx.use($services.webjars.url('bootstrap-daterangepicker',
      'css/bootstrap-daterangepicker.css'), {'type': 'text/css', 'rel': 'stylesheet'}))
#set ($discard = $xwiki.jsfx.use('uicomponents/suggest/xwiki.selectize.js', true))
#set ($discard = $xwiki.ssrx.use('css/projectmanagement/filterBuilder.css'))
#set ($clientId = "$!parameters.client")
## TODO: Not a great way to do it. We are basically using variables defined in other scripts. Need to find another way.
#if ($clientId == '')
  #set ($clientId = "$!macroId")
#end
#if ($clientId == '')
  #set ($clientId = "$!macroIdAsString")
  ## i.e. macroname/xwiki/2.1
  #set ($clientId = $clientId.split('/')[0])
#end
## The properties of the instance of the client, if any, are loaded by the JavaScript code once it's known.
#getFilterableProperties($clientId {} $filterableProperties)
#if ("$!filterableProperties" != '')
  #if ($filterableProperties.isEmpty())
    <div class="box warningmessage">$!escapetool.xml($services.localization.render("projectmanagement.macro.filter.noFilters"))</div>
  #else
    ## The labels displayed by the filter builder: the operators (by type of filter and operator id, the labels of
    ## the configuration being used for the other operators) and the words of the summary of the filters.
    ## The operator ids aren't valid in translation keys, so the operators are translated by name.
    #set ($operatorKeys = {
      'list.=': 'list.isOneOf', 'list.!': 'list.isNotOneOf', 'list.&=': 'list.hasAllOf', 'list.*': 'isSet',
      'list.!*': 'isNotSet', 'list.o': 'list.isOpen', 'list.c': 'list.isClosed',
      'text.~': 'text.contains', 'text.!~': 'text.doesNotContain', 'text.=': 'is', 'text.!': 'isNot',
      'text.*': 'isSet', 'text.!*': 'isNotSet',
      'number.=': 'number.equals', 'number.!': 'number.notEquals', 'number.>=': 'number.atLeast',
      'number.<=': 'number.atMost', 'number.*': 'isSet', 'number.!*': 'isNotSet',
      'date.t': 'date.isToday', 'date.w': 'date.isThisWeek', 'date.=d': 'date.isOn', 'date.between': 'date.isBetween',
      'date.!*': 'isNotSet', 'boolean.=': 'is', 'boolean.!': 'isNot'
    })
    #set ($l10n = {})
    #foreach ($operatorKey in $operatorKeys.entrySet())
      #set ($discard = $l10n.put($operatorKey.key,
        $services.localization.render("projectmanagement.macro.filter.operator.$operatorKey.value")))
    #end
    #foreach ($key in ['anotherCondition', 'summary', 'summaryAll', 'summaryIncomplete', 'and', 'or', 'between'])
      #set ($discard = $l10n.put($key, $services.localization.render("projectmanagement.macro.filter.$key")))
    #end
    <div class="proj-manag-constraint-builder proj-manag-macro-param" data-client="$escapetool.xml($clientId)"
      data-cfg="$escapetool.xml($jsontool.serialize($filterableProperties))"
      data-l10n="$escapetool.xml($jsontool.serialize($l10n))">
      <div class="proj-manag-header">
      #if ($parameters.title)
        <span class="proj-manag-header-title">$escapetool.xml($parameters.title)</span>
      #end
      #if ($parameters.removable && !$parameters.readonly)
        <a class="proj-manag-remove-filter">$services.icon.renderHTML('trash')</a>
      #end
      </div>
      ## One row per filter: the property, the operator and the value(s).
      <div class="proj-manag-constraints">
      </div>
      #if (!$parameters.readonly)
        <div class="proj-manag-add-filter-container">
          <label>$escapetool.xml($services.localization.render('projectmanagement.macro.filter.addFilterOn'))
            <select class="proj-manag-add-filter">
              <option selected value="">$escapetool.xml($services.localization.render(
                'projectmanagement.macro.filter.chooseProperty'))</option>
              #foreach ($prop in $filterableProperties)
                <option value="$!escapetool.xml($prop.id)">#if($prop.name)$escapetool.xml($prop.name)#else$!escapetool.xml($prop.id)#end</option>
              #end
            </select>
          </label>
        </div>
      #end
      ## What the filters select, in plain words.
      <p class="proj-manag-filter-summary xHint"></p>
      <div id="proj-manag-constraint-template" class="hidden">
        <span class="proj-manag-constraint-title">Some title</span>
        <input #if($parameters.readonly)disabled#end type="text" class="proj-manag-constraint-name hidden"/>
        <div class="proj-manag-constraint-operator-container">
          <select #if($parameters.readonly)disabled#end class="proj-manag-constraint-operator">
          </select>
        </div>
        <div class="proj-manag-container proj-manag-constraint-value-container">
          <input #if($parameters.readonly)disabled#end class="proj-manag-constraint-value" type="text"/>
        </div>
        #if(!$parameters.readonly)
          <div class="proj-manag-constraint-remove-container">
            <a href="#" title="$escapetool.xml($services.localization.render('projectmanagement.macro.filter.remove'))"
              class="proj-manag-delete-filter">$services.icon.renderHTML('trash')</a>
          </div>
        #end
      </div>
    </div>
  #end
#else
  <div class="box warningmessage">$!escapetool.xml($services.localization.render("projectmanagement.macro.filter.noFilters"))</div>
#end
#end
