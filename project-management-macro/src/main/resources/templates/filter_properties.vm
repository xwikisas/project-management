## The properties a filter builder proposes, as JSON, for the client and the livedata source parameters of the request
## (e.g. the instance of the client chosen in a macro editor): ?xpage=filter_properties&client=...&sourceParameters=...
#template('filter_builder.vm')
#set ($sourceParameters = {})
#if ("$!request.sourceParameters" != '')
  #set ($parsedSourceParameters = $jsontool.fromString($request.sourceParameters))
  #if ($parsedSourceParameters && $parsedSourceParameters.entrySet())
    #foreach ($entry in $parsedSourceParameters.entrySet())
      #set ($discard = $sourceParameters.put($entry.key, "$!entry.value"))
    #end
  #end
#end
#getFilterableProperties("$!request.client" $sourceParameters $filterableProperties)
#if ("$!filterableProperties" == '')
  #set ($filterableProperties = [])
#end
#set ($discard = $response.setContentType('application/json'))
$jsontool.serialize($filterableProperties)
