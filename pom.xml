<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.xwiki.parent</groupId>
    <artifactId>xwikisas-parent-platform</artifactId>
    <version>15.10-6</version>
  </parent>
  <groupId>com.xwiki.projectmanagement</groupId>
  <artifactId>project-management</artifactId>
  <version>1.4.2-SNAPSHOT</version>
  <name>Project Management - Parent POM</name>
  <properties>
    <xwikipro.commons.version>1.4.0</xwikipro.commons.version>
    <licensing.version>1.32.3</licensing.version>
    <urlshortener.version>1.3.4</urlshortener.version>
    <fullcalendar.version>2.5.4</fullcalendar.version>
    <!-- The JavaScript unit tests (src/test/node of the modules declaring the frontend-maven-plugin), run with
         Vitest. -->
    <node.version>v22.12.0</node.version>
    <pnpm.version>9.15.9</pnpm.version>
    <!-- Set by the profiles skipping the tests, so that Node and the dependencies aren't installed either. -->
    <projectmanagement.js.tests.skip>false</projectmanagement.js.tests.skip>
  </properties>
  <packaging>pom</packaging>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/xwikisas/project-management/issues</url>
  </issueManagement>
  <scm>
    <connection>scm:git:git://github.com/xwikisas/project-management.git</connection>
    <developerConnection>scm:git:git@github.com:xwikisas/project-management.git</developerConnection>
    <url>https://github.com/xwikisas/project-management/tree/master</url>
    <tag>project-management-1.2.0-rc-7</tag>
  </scm>
  <modules>
    <!-- Remove this module, and the dependencies on it, when the parent pom moves to XWiki 17.10.x, which provides the
      APIs it copies (PropertyOrder since 17.5.0). -->
    <module>project-management-compat</module>
    <module>project-management-api</module>
    <module>project-management-livedata</module>
    <module>project-management-macro</module>
    <module>project-management-openproject</module>
    <module>project-management-relations</module>
    <module>project-management-calendar</module>
    <module>project-management-presets</module>
  </modules>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- Same arguments as in the parent POM, plus the Byte Buddy agent used by Mockito's inline mock maker,
                 loaded at startup instead of letting Mockito attach it at runtime: starting with Java 21, the JVM
                 prints a warning on such a dynamic attach, which fails the tests that check that nothing is written to
                 the console. The Byte Buddy agent is used because the Mockito version of the parent POM (5.7.0) can't
                 be loaded as an agent itself. Remove once on a parent POM that does it (XWiki Commons loads Mockito as
                 an agent since its upgrade to Mockito 5.24.0, XCOMMONS-3810, not backported to the 15.10 branch). -->
            <argLine>@{argLine} -Xmx1024m -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=${project.build.directory} --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.io=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/java.util.concurrent=ALL-UNNAMED -javaagent:"${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${bytebuddy.version}/byte-buddy-agent-${bytebuddy.version}.jar"</argLine>
          </configuration>
        </plugin>
        <plugin>
          <!-- Runs the JavaScript unit tests of src/test/node with Vitest, as in xwiki-platform: Node and pnpm are
               installed in target. -->
          <groupId>com.github.eirslett</groupId>
          <artifactId>frontend-maven-plugin</artifactId>
          <version>2.0.2</version>
          <configuration>
            <workingDirectory>${basedir}/src/test/node</workingDirectory>
            <installDirectory>${project.build.directory}</installDirectory>
            <skip>${projectmanagement.js.tests.skip}</skip>
          </configuration>
          <executions>
            <execution>
              <id>install-node-and-pnpm</id>
              <phase>process-test-resources</phase>
              <goals>
                <goal>install-node-and-pnpm</goal>
              </goals>
              <configuration>
                <nodeVersion>${node.version}</nodeVersion>
                <pnpmVersion>${pnpm.version}</pnpmVersion>
              </configuration>
            </execution>
            <execution>
              <id>pnpm-install</id>
              <phase>process-test-resources</phase>
              <goals>
                <goal>pnpm</goal>
              </goals>
              <configuration>
                <arguments>install</arguments>
                <environmentVariables>
                  <!-- Install the dependencies of the lock file, without updating it. -->
                  <CI>true</CI>
                </environmentVariables>
              </configuration>
            </execution>
            <execution>
              <id>pnpm-test</id>
              <phase>test</phase>
              <goals>
                <goal>pnpm</goal>
              </goals>
              <configuration>
                <arguments>run test:unit</arguments>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <!-- The dependencies installed by pnpm for the JavaScript tests are removed with the build. -->
          <artifactId>maven-clean-plugin</artifactId>
          <configuration>
            <filesets>
              <fileset>
                <directory>${basedir}/src/test/node/node_modules</directory>
              </fileset>
            </filesets>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
  <profiles>
    <!-- Skip the JavaScript tests, and the installation of Node and of their dependencies, with the Java tests. -->
    <profile>
      <id>skip-js-tests-with-skipTests</id>
      <activation>
        <property>
          <name>skipTests</name>
          <value>true</value>
        </property>
      </activation>
      <properties>
        <projectmanagement.js.tests.skip>true</projectmanagement.js.tests.skip>
      </properties>
    </profile>
    <profile>
      <id>skip-js-tests-with-maven.test.skip</id>
      <activation>
        <property>
          <name>maven.test.skip</name>
          <value>true</value>
        </property>
      </activation>
      <properties>
        <projectmanagement.js.tests.skip>true</projectmanagement.js.tests.skip>
      </properties>
    </profile>
    <profile>
      <id>integration-tests</id>
      <modules>
        <module>project-management-test</module>
      </modules>
    </profile>
  </profiles>
</project>
