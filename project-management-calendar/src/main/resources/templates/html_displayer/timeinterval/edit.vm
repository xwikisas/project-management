## ---------------------------------------------------------------------------
## Time interval displayer: renders two time inputs (start and end) separated by a dash, backed by a hidden input
## storing the value of the parameter, e.g. 06:00-20:00. The macro editor renders this template without the value of
## the parameter, then sets it in the hidden input: the script displays it in the time inputs.
## ---------------------------------------------------------------------------
## The styles putting the two time inputs on one line. The calendar macro loads them too, but the macro editor can't rely
## on it: the edited page may display no calendar (a new one, or one failing with an error).
#set ($discard = $xwiki.ssrx.use('projectmanagercalendar/css/parameters.css'))
#set ($discard = $xwiki.jsrx.use('projectmanagercalendar/js/timeInterval.js'))
## Hidden input stores the combined value for the macro parameter.
<input type="hidden" name="$escapetool.xml($displayer.parameters.name)"
  id="$!escapetool.xml($displayer.parameters.id)" class="time-interval-hidden"/>
<div class="time-interval-inputs">
  <input type="time" class="time-interval-min" title="$escapetool.xml(
    $services.localization.render('calendar.timeinterval.min.title'))" placeholder="06:00"/>
  <span class="time-interval-separator">–</span>
  <input type="time" class="time-interval-max" title="$escapetool.xml(
    $services.localization.render('calendar.timeinterval.max.title'))" placeholder="20:00"/>
</div>
