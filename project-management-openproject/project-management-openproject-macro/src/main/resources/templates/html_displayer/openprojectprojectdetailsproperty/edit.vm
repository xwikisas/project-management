## Same picker as the one of the work package properties (see property_picker.vm), proposing the project properties.
#template('pickers_macros.vm')
#set ($discard = $xwiki.jsrx.use('js/projectmanagement/macro/propertyParameter.js', {'minify': false}))
#set ($selectedProperties = [])
#foreach ($property in $displayer.value)
  #set ($discard = $selectedProperties.add("$property"))
#end
#set ($options = [])
#foreach ($property in ['ID', 'NAME', 'IDENTIFIER', 'DESCRIPTION', 'STATUS', 'CREATED'])
  #set ($discard = $options.add({
    'name': $services.localization.render("openproject.openproject-project-details.labels.$property.toLowerCase()"),
    'value': $property
  }))
#end
#set ($parameters = {
  'class': 'proj-manag-property-picker',
  'data-remove-title': $services.localization.render('projectmanagement.macro.properties.removebutton.title'),
  'multiple': 'multiple',
  'options': $options,
  'prefix': ' '
})
#set ($discard = $parameters.putAll($displayer.parameters))
#set ($discard = $parameters.put('value', $selectedProperties))
#suggestInput($parameters, 'staticPickerDisplayOptions')
