## Same picker as the one of the work package properties (see property_picker.vm), proposing the project properties.
## The value is held by a hidden input named after the parameter, and the picker has no name: on XWiki versions older
## than 17.10, the macro editor splits the value of a multiple select on commas, which fails on the default value of a
## list parameter (a JSON array). propertyParameter.js keeps the hidden input and the picker in sync.
## When the minimal supported XWiki version (the parent version in the root pom.xml) is 17.10 or later, remove this
## workaround: drop the hidden input, keep the 'name' and 'id' parameters on the picker, and remove syncWithValueInput
## from propertyParameter.js.
#template('pickers_macros.vm')
#set ($discard = $xwiki.jsrx.use('js/projectmanagement/macro/propertyParameter.js', {'minify': false}))
#set ($selectedProperties = [])
#foreach ($property in $displayer.value)
  #set ($discard = $selectedProperties.add("$property"))
#end
#set ($options = [])
#foreach ($property in ['ID', 'NAME', 'IDENTIFIER', 'DESCRIPTION', 'STATUS', 'CREATED'])
  #set ($discard = $options.add({
    'name': $services.localization.render("openproject.openproject-project-details.labels.$property.toLowerCase()"),
    'value': $property
  }))
#end
#set ($parameters = {
  'class': 'proj-manag-property-picker',
  'data-remove-title': $services.localization.render('projectmanagement.macro.properties.removebutton.title'),
  'multiple': 'multiple',
  'options': $options,
  'prefix': ' '
})
#set ($discard = $parameters.putAll($displayer.parameters))
#set ($discard = $parameters.remove('name'))
#set ($discard = $parameters.remove('id'))
#set ($discard = $parameters.put('value', $selectedProperties))
<div class="proj-manag-property-picker-field">
  <input type="hidden" name="$!escapetool.xml($displayer.parameters.name)"#if ("$!displayer.parameters.id" != '')
    id="$escapetool.xml($displayer.parameters.id)"#end
    class="proj-manag-property-picker-value" value="$escapetool.xml($stringtool.join($selectedProperties, ','))"/>
  #suggestInput($parameters, 'staticPickerDisplayOptions')
</div>
