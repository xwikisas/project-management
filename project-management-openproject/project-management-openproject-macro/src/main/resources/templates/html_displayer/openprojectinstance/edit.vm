## Moves the value of the deprecated count parameter of the macros having one (all have an instance parameter) to
## the limit parameter.
#set ($discard = $xwiki.jsrx.use('openproject/js/countParameter.js', {'minify': false}))
## A short list of connections, so a plain select, like the macro parameters taking a few values.
#set ($defaultConnection = $services.openproject.defaultConnectionName)
<select class="op-instance-select" data-default-connection="$!escapetool.xml($defaultConnection)"
  #foreach ($parameter in $displayer.parameters.entrySet())
    $escapetool.xml($parameter.key)="$!escapetool.xml($parameter.value)"
  #end
>
## Leaving the connection empty makes the macro use the default connection. On an OpenProject dashboard, the macro
## uses the connection selected on the dashboard instead, which has its own option.
#if (!$services.openproject.isDashboardContext())
  #if ("$!defaultConnection" != '')
    #set ($emptyLabel = $services.localization.render('openproject.instance.defaultConnection', [$defaultConnection]))
  #else
    #set ($emptyLabel = $services.localization.render('openproject.instance.noDefaultConnection'))
  #end
  <option value="">$escapetool.xml($emptyLabel)</option>
#end
#foreach ($option in $services.openproject.getConnectionOptions())
  ## The label of the dashboard option is a translation key, the label of a connection is its name.
  #set ($label = $option.name)
  #if ($option.name != $option.value)
    #set ($label = $services.localization.render($option.name))
  #end
  <option value="$escapetool.xml($option.value)">$escapetool.xml($label)</option>
#end
</select>