      <content>{{velocity}}
#set ($isOwnProfile = $xcontext.userReference == $doc.documentReference)
#if ($isOwnProfile &amp;&amp; $request.method == 'POST' &amp;&amp; "$!request.openprojectDisconnect" != '' &amp;&amp; $services.csrf.isTokenValid($request.form_token))
  #if ($services.openproject.disconnect($request.openprojectDisconnect))
    #set ($message = $services.localization.render('openproject.userprofile.disconnected', [$request.openprojectDisconnect]))
    {{success}}$services.rendering.escape($message, 'xwiki/2.1'){{/success}}
  #else
    #set ($message = $services.localization.render('openproject.userprofile.disconnectFailed', [$request.openprojectDisconnect]))
    {{error}}$services.rendering.escape($message, 'xwiki/2.1'){{/error}}
  #end
#end
(% id="HOpenProject" %)
== $services.localization.render('openproject.userprofile.title') ==

$services.localization.render('openproject.userprofile.description')

## Only the connections to which the users can connect their OpenProject account (the tab is hidden when there are
## none, see the isActive parameter).
#set ($connections = $services.openproject.userAccountConnections)
#if (!$isOwnProfile)
  ## The statuses and the actions are those of the current user, not of the user whose profile is displayed.
#elseif ($connections.isEmpty())
  {{info}}$services.localization.render('openproject.userprofile.noConnections'){{/info}}
#else
  #set ($profileURL = $doc.getURL('view', 'category=openproject'))
  {{html clean="false"}}
  &lt;table class="table openproject-user-connections"&gt;
    &lt;thead&gt;&lt;tr&gt;
      &lt;th scope="col"&gt;$escapetool.xml($services.localization.render('openproject.userprofile.connection'))&lt;/th&gt;
      &lt;th scope="col"&gt;$escapetool.xml($services.localization.render('openproject.userprofile.server'))&lt;/th&gt;
      &lt;th scope="col"&gt;$escapetool.xml($services.localization.render('openproject.userprofile.status'))&lt;/th&gt;
      &lt;th scope="col"&gt;&lt;span class="sr-only"&gt;$escapetool.xml($services.localization.render('openproject.userprofile.actions'))&lt;/span&gt;&lt;/th&gt;
    &lt;/tr&gt;&lt;/thead&gt;
    &lt;tbody&gt;
    #foreach ($connection in $connections)
      #set ($connectionName = $connection)
      #set ($serverURL = $services.openproject.getConnectionUrl($connectionName))
      #set ($connected = $services.openproject.isUserAuthorized($connectionName))
      &lt;tr&gt;
        &lt;td&gt;$escapetool.xml($connectionName)&lt;/td&gt;
        #set ($lowerCaseServerURL = "$!serverURL.toLowerCase()")
        #if ($lowerCaseServerURL.startsWith('http://') || $lowerCaseServerURL.startsWith('https://'))
          &lt;td&gt;&lt;a href="$escapetool.xml($serverURL)"&gt;$escapetool.xml($serverURL)&lt;/a&gt;&lt;/td&gt;
        #else
          &lt;td&gt;$escapetool.xml($serverURL)&lt;/td&gt;
        #end
        &lt;td&gt;
        #if ($connected)
          &lt;span class="label label-success"&gt;$escapetool.xml($services.localization.render('openproject.userprofile.connected'))&lt;/span&gt;
        #else
          &lt;span class="label label-default"&gt;$escapetool.xml($services.localization.render('openproject.userprofile.notConnected'))&lt;/span&gt;
        #end
        &lt;/td&gt;
        &lt;td class="text-right"&gt;
        #if ($connected)
          &lt;form method="post" action="$escapetool.xml($profileURL)"&gt;
            &lt;input type="hidden" name="form_token" value="$!escapetool.xml($services.csrf.token)" /&gt;
            &lt;input type="hidden" name="openprojectDisconnect" value="$escapetool.xml($connectionName)" /&gt;
            &lt;button type="submit" class="btn btn-default btn-sm"&gt;$escapetool.xml($services.localization.render('openproject.userprofile.disconnect'))&lt;/button&gt;
          &lt;/form&gt;
        #else
          #set ($connectURL = $xwiki.getURL('OpenProject.Code.RenewOAuthConnection', 'view', $escapetool.url({
            'connectionName': $connectionName,
            'redirectUrl': $profileURL,
            'token': $services.csrf.token
          })))
          &lt;a class="btn btn-primary btn-sm" href="$escapetool.xml($connectURL)"&gt;$escapetool.xml($services.localization.render('openproject.userprofile.connect'))&lt;/a&gt;
        #end
        &lt;/td&gt;
      &lt;/tr&gt;
    #end
    &lt;/tbody&gt;
  &lt;/table&gt;
  {{/html}}
#end
{{/velocity}}</content>
