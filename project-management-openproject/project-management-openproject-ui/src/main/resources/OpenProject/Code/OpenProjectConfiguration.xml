    <property>
      <code>(function() {
  const FORM_ID = 'openproject_OpenProject.Code.OpenProjectConfiguration';
  const FAILURES = ['badInput', 'patternMismatch', 'rangeOverflow', 'rangeUnderflow', 'stepMismatch', 'tooLong',
    'tooShort', 'typeMismatch', 'valueMissing'];

  // Use the translated validation messages from the data-validation-* attributes, like the XWiki edit forms do.
  const useCustomValidationMessage = function(field) {
    const failure = FAILURES.find(failure =&gt; field.validity[failure]);
    // Convert 'patternMismatch' into 'data-validation-pattern-mismatch'.
    const message = failure &amp;&amp;
      field.getAttribute('data-validation-' + failure.replace(/([A-Z])/g, match =&gt; `-${match.toLowerCase()}`));
    if (message) {
      field.setCustomValidity(message);
      // Remove the custom message as soon as the value changes, otherwise the field remains invalid.
      field.addEventListener('input', () =&gt; field.setCustomValidity(''), {once: true});
    }
  };

  // The administration replaces the save button of each section with a single button that saves all the forms
  // without validating them. Validate our form before that button's click listener is called.
  document.addEventListener('click', function(event) {
    const form = document.getElementById(FORM_ID);
    if (!form || !event.target.matches('#admin-page-content input[type="submit"]') || form.checkValidity()) {
      return;
    }
    [...form.elements].filter(field =&gt; !field.validity.valid).forEach(useCustomValidationMessage);
    form.reportValidity();
    event.preventDefault();
    event.stopImmediatePropagation();
  }, true);
})();</code>
